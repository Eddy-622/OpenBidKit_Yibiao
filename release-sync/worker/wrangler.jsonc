{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbidkit-atomgit-release-test",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "placement": {
    "hostname": "api.atomgit.com"
  },
  "limits": {
    "cpu_ms": 300000
  },
  "vars": {
    "ATOMGIT_OWNER": "FB208",
    "ATOMGIT_REPO": "OpenBidKit_Yibiao",
    "R2_RELEASE_PREFIX": "release"
  },
  "r2_buckets": [
    {
      "binding": "RELEASE_BUCKET",
      "bucket_name": "openbidkit"
    }
  ]
}
